{
  "name": "meridian-oracle-transactions-cdc",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "4",
    "database.hostname": "oracle-dwh.meridian.internal",
    "database.port": "1521",
    "database.user": "${file:/opt/kafka/secrets/oracle.properties:username}",
    "database.password": "${file:/opt/kafka/secrets/oracle.properties:password}",
    "database.dbname": "MERDWH",
    "database.pdb.name": "MERIDIAN_PDB",
    "database.server.name": "meridian",
    "topic.prefix": "meridian.core_banking",
    "schema.include.list": "CORE_BANKING",
    "table.include.list": "CORE_BANKING.TRANSACTIONS",
    "database.history.kafka.bootstrap.servers": "b-1.meridian-msk.eu-west-1.kafka.amazonaws.com:9092",
    "database.history.kafka.topic": "meridian.schema-changes.transactions",
    "log.mining.strategy": "online_catalog",
    "log.mining.continuous.mine": "true",
    "snapshot.mode": "initial",
    "snapshot.fetch.size": "10000",
    "decimal.handling.mode": "precise",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "transforms": "unwrap,addMetadata",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.addMetadata.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.addMetadata.static.field": "_cdc_source",
    "transforms.addMetadata.static.value": "debezium_oracle",
    "heartbeat.interval.ms": "30000",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "meridian.dlq.transactions",
    "errors.deadletterqueue.context.headers.enable": "true"
  }
}
