# =============================================================================
# Trino JVM Configuration — Project ATLAS
# =============================================================================
# Optimised for r6g.4xlarge (128 GB RAM, ARM64/Graviton3) running on EKS.
# Heap set to 80GB leaving headroom for off-heap, OS, and container overhead.
# =============================================================================

# --- Heap Size ---
-Xmx80G
-Xms80G

# --- GC Configuration ---
# G1GC for predictable pause times on large heaps
-XX:+UseG1GC
-XX:G1HeapRegionSize=32M
-XX:MaxGCPauseMillis=200
-XX:InitiatingHeapOccupancyPercent=45
-XX:G1ReservePercent=15
-XX:+ParallelRefProcEnabled
-XX:+UnlockExperimentalVMOptions
-XX:G1NewSizePercent=10
-XX:G1MaxNewSizePercent=30

# --- Memory ---
-XX:+UseCompressedOops
-XX:ReservedCodeCacheSize=512M
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=/var/log/trino/heap-dump.hprof
-XX:OnOutOfMemoryError=kill -9 %p
-XX:MaxDirectMemorySize=16G

# --- Performance ---
-XX:+UseStringDeduplication
-XX:+OptimizeStringConcat
-XX:-UseBiasedLocking
-XX:+AlwaysPreTouch

# --- JIT Compiler ---
-XX:+TieredCompilation
-XX:CompileThreshold=5000

# --- Diagnostics ---
-XX:+ExitOnOutOfMemoryError
-XX:+UnlockDiagnosticVMOptions
-XX:+DebugNonSafepoints

# --- GC Logging ---
-Xlog:gc*:file=/var/log/trino/gc.log:time,uptime,level,tags:filecount=10,filesize=50M

# --- Security ---
-Djdk.attach.allowAttachSelf=true
-Djdk.nio.maxCachedBufferSize=2000000
-Dfile.encoding=UTF-8

# --- Network ---
-Djava.net.preferIPv4Stack=true
-Dsun.net.inetaddr.ttl=60

# --- Trino-specific ---
-Duser.timezone=UTC
-Dlog.enable-console=false
