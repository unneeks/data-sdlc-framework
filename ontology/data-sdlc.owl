<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:dsdlc="http://example.org/ontology/data-sdlc#">

  <!-- ═══════════════════════════════════════════════════════════════════════
       OWL Ontology: Agentic Data SDLC Framework
       Domain: Data Engineering Delivery Lifecycle with AI Agent Orchestration
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:Ontology rdf:about="http://example.org/ontology/data-sdlc">
    <dc:title>Agentic Data SDLC Ontology</dc:title>
    <dc:description>An ontology for modelling the complete lifecycle of data engineering deliveries, including technical twins (data assets, pipelines, lineage), delivery twins (plans, phases, tasks, gates), AI agents, skills, tools, and governance constructs.</dc:description>
    <dc:creator>Data SDLC Framework</dc:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>

  <!-- ═══════════════════════════════════════════════════════════════════════
       CLASSES — Technical Twin
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Project">
    <rdfs:label>Project</rdfs:label>
    <rdfs:comment>A data engineering project containing assets, pipelines, and delivery plans.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#DataAsset">
    <rdfs:label>Data Asset</rdfs:label>
    <rdfs:comment>A logical or physical data entity (table, view, topic, storage object) in the technical twin.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Pipeline">
    <rdfs:label>Pipeline</rdfs:label>
    <rdfs:comment>A data transformation or ingestion pipeline (dbt, Dataflow, Airflow, Spark).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#LineageNode">
    <rdfs:label>Lineage Node</rdfs:label>
    <rdfs:comment>A node in the data lineage graph representing an asset or transformation step.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#LineageEdge">
    <rdfs:label>Lineage Edge</rdfs:label>
    <rdfs:comment>A directed dependency relationship between two lineage nodes.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#CodeArtifact">
    <rdfs:label>Code Artifact</rdfs:label>
    <rdfs:comment>A versioned source code file (SQL, Python, YAML, HCL) in a repository.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#InfrastructureResource">
    <rdfs:label>Infrastructure Resource</rdfs:label>
    <rdfs:comment>A cloud infrastructure resource (storage bucket, BigLake table, etc.) managed as code.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Change">
    <rdfs:label>Change</rdfs:label>
    <rdfs:comment>A change request or modification event that triggers impact analysis and delivery workflows.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Test">
    <rdfs:label>Test</rdfs:label>
    <rdfs:comment>A validation test (schema parity, reconciliation, data quality, regression).</rdfs:comment>
  </owl:Class>

  <!-- ═══════════════════════════════════════════════════════════════════════
       CLASSES — Delivery Twin
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#DeliveryType">
    <rdfs:label>Delivery Type</rdfs:label>
    <rdfs:comment>A category of data engineering work (migration, new product, amendment, defect, etc.).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#DeliveryBlueprint">
    <rdfs:label>Delivery Blueprint</rdfs:label>
    <rdfs:comment>A versioned template defining the standard phases, tasks, and gates for a delivery type.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#DeliveryPlan">
    <rdfs:label>Delivery Plan</rdfs:label>
    <rdfs:comment>An instantiated plan for a specific project, derived from a blueprint.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#DeliveryPhase">
    <rdfs:label>Delivery Phase</rdfs:label>
    <rdfs:comment>A sequential stage in a delivery plan (Architecture, Design, Development, Testing, Operations).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#DeliveryTask">
    <rdfs:label>Delivery Task</rdfs:label>
    <rdfs:comment>A discrete unit of work within a delivery phase, with inputs, outputs, and acceptance criteria.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#ApprovalGate">
    <rdfs:label>Approval Gate</rdfs:label>
    <rdfs:comment>A quality/compliance checkpoint that must be passed before proceeding to the next phase.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Evidence">
    <rdfs:label>Evidence</rdfs:label>
    <rdfs:comment>A verifiable artifact (git diff, test report, data profile) that supports gate approval.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#ChecklistItem">
    <rdfs:label>Checklist Item</rdfs:label>
    <rdfs:comment>A discrete completion criterion within a delivery task.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#AcceptanceCriterion">
    <rdfs:label>Acceptance Criterion</rdfs:label>
    <rdfs:comment>A measurable condition that must be satisfied for a task to be considered complete.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Approval">
    <rdfs:label>Approval</rdfs:label>
    <rdfs:comment>A decision record for a gate (approved, rejected, pending).</rdfs:comment>
  </owl:Class>

  <!-- ═══════════════════════════════════════════════════════════════════════
       CLASSES — Agent Ecosystem
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Agent">
    <rdfs:label>Agent</rdfs:label>
    <rdfs:comment>An AI agent with specific capabilities, skills, tools, and governance policies.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Skill">
    <rdfs:label>Skill</rdfs:label>
    <rdfs:comment>A reusable capability that an agent can exercise (e.g., impact-analysis, schema-mapping).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Tool">
    <rdfs:label>Tool</rdfs:label>
    <rdfs:comment>An executable instrument (CLI, API, query, scanner) that agents use to perform work.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#KnowledgePack">
    <rdfs:label>Knowledge Pack</rdfs:label>
    <rdfs:comment>A curated collection of domain knowledge documents that inform agent reasoning.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#Policy">
    <rdfs:label>Policy</rdfs:label>
    <rdfs:comment>A governance rule set (security, quality, release) constraining agent behaviour.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#DeliveryContract">
    <rdfs:label>Delivery Contract</rdfs:label>
    <rdfs:comment>A binding agreement between a task and an agent, specifying inputs, outputs, skills, tools, and approval gates.</rdfs:comment>
  </owl:Class>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ENUMERATIONS (Named Individuals as OWL OneOf)
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#RiskLevel">
    <rdfs:label>Risk Level</rdfs:label>
    <owl:oneOf rdf:parseType="Collection">
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#HIGH"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#MEDIUM"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#LOW"/>
    </owl:oneOf>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#AutonomyLevel">
    <rdfs:label>Autonomy Level</rdfs:label>
    <owl:oneOf rdf:parseType="Collection">
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#AUTOMATIC"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#SEMI_AUTOMATIC"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#APPROVAL_REQUIRED"/>
    </owl:oneOf>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#CertificationStatus">
    <rdfs:label>Certification Status</rdfs:label>
    <owl:oneOf rdf:parseType="Collection">
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#CERTIFIED"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#EVALUATING"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#DEPRECATED"/>
    </owl:oneOf>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#AssetStatus">
    <rdfs:label>Asset Status</rdfs:label>
    <owl:oneOf rdf:parseType="Collection">
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#ACTIVE"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#MIGRATING"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#DEPRECATED_STATUS"/>
    </owl:oneOf>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#TaskStatus">
    <rdfs:label>Task Status</rdfs:label>
    <owl:oneOf rdf:parseType="Collection">
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#NOT_STARTED"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#IN_PROGRESS"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#COMPLETED"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#FAILED"/>
    </owl:oneOf>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#GateStatus">
    <rdfs:label>Gate Status</rdfs:label>
    <owl:oneOf rdf:parseType="Collection">
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#PASSED"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#BLOCKED"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#PENDING"/>
    </owl:oneOf>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/data-sdlc#EvidenceConfidence">
    <rdfs:label>Evidence Confidence</rdfs:label>
    <owl:oneOf rdf:parseType="Collection">
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#OBSERVED"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#INFERRED"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#LIKELY"/>
      <owl:NamedIndividual rdf:about="http://example.org/ontology/data-sdlc#CONFIRMED"/>
    </owl:oneOf>
  </owl:Class>

  <!-- ═══════════════════════════════════════════════════════════════════════
       OBJECT PROPERTIES — Technical Twin Relationships
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasDataAsset">
    <rdfs:label>has data asset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Project"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DataAsset"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasPipeline">
    <rdfs:label>has pipeline</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Project"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Pipeline"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#consumesInput">
    <rdfs:label>consumes input</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Pipeline"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DataAsset"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#producesOutput">
    <rdfs:label>produces output</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Pipeline"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DataAsset"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#dependsOn">
    <rdfs:label>depends on</rdfs:label>
    <rdfs:comment>Lineage dependency between nodes.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#LineageNode"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#LineageNode"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasSource">
    <rdfs:label>has source</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#LineageEdge"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#LineageNode"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasTarget">
    <rdfs:label>has target</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#LineageEdge"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#LineageNode"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#impacts">
    <rdfs:label>impacts</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Change"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DataAsset"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#modifiesFile">
    <rdfs:label>modifies file</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Change"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#CodeArtifact"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#testsAsset">
    <rdfs:label>tests asset</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Test"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DataAsset"/>
  </owl:ObjectProperty>

  <!-- ═══════════════════════════════════════════════════════════════════════
       OBJECT PROPERTIES — Delivery Twin Relationships
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasDeliveryPlan">
    <rdfs:label>has delivery plan</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Project"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DeliveryPlan"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#derivedFromBlueprint">
    <rdfs:label>derived from blueprint</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryPlan"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DeliveryBlueprint"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#blueprintForType">
    <rdfs:label>blueprint for type</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryBlueprint"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DeliveryType"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasPhase">
    <rdfs:label>has phase</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryPlan"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DeliveryPhase"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasTask">
    <rdfs:label>has task</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryPhase"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DeliveryTask"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasGate">
    <rdfs:label>has gate</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryPhase"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#ApprovalGate"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#requiresEvidence">
    <rdfs:label>requires evidence</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#ApprovalGate"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Evidence"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasChecklist">
    <rdfs:label>has checklist</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#ChecklistItem"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasAcceptanceCriterion">
    <rdfs:label>has acceptance criterion</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#AcceptanceCriterion"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasApproval">
    <rdfs:label>has approval</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#ApprovalGate"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Approval"/>
  </owl:ObjectProperty>

  <!-- ═══════════════════════════════════════════════════════════════════════
       OBJECT PROPERTIES — Agent Ecosystem Relationships
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasSkill">
    <rdfs:label>has skill</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Agent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Skill"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#usesTool">
    <rdfs:label>uses tool</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Agent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Tool"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#hasKnowledgePack">
    <rdfs:label>has knowledge pack</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Agent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#KnowledgePack"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#governedByPolicy">
    <rdfs:label>governed by policy</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Agent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Policy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#supportsDeliveryType">
    <rdfs:label>supports delivery type</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Agent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DeliveryType"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#assignedToTask">
    <rdfs:label>assigned to task</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Agent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DeliveryTask"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#requiresAgent">
    <rdfs:label>requires agent</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Agent"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/data-sdlc#assignedToTask"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#skillRequiresTool">
    <rdfs:label>skill requires tool</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#Skill"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Tool"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#contractBindsAgent">
    <rdfs:label>contract binds agent</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryContract"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#Agent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#contractBindsTask">
    <rdfs:label>contract binds task</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryContract"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#DeliveryTask"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/data-sdlc#contractRequiresGate">
    <rdfs:label>contract requires gate</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/data-sdlc#DeliveryContract"/>
    <rdfs:range rdf:resource="http://example.org/ontology/data-sdlc#ApprovalGate"/>
  </owl:ObjectProperty>

  <!-- ═══════════════════════════════════════════════════════════════════════
       DATATYPE PROPERTIES
       ═══════════════════════════════════════════════════════════════════════ -->

  <owl:DatatypeProperty rdf:about="http://example.org/ontology/data-sdlc#identifier">
    <rdfs:label>identifier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/ontology/data-sdlc#name">
    <rdfs:label>name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
